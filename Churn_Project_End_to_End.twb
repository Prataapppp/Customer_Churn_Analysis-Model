        <column caption='Cus Internet Service' datatype='string' name='[Calculation_1303774317572103]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Internet Service]=&apos;DSL&apos; THEN &quot;INTERNET SERVICE: DSL&quot; ELSEIF [Internet Service]=&apos;Fiber optic&apos; THEN &quot;INTERNET SERVICE: Fiber Optics&quot; ELSE&#13;&#10;&quot;No Internet Service&quot; END' />
