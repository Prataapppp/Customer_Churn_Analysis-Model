      <aliases enabled='yes' />
      <column caption='Cltv' datatype='integer' name='[CLTV]' role='measure' type='quantitative' />
      <column caption='Average Charges' datatype='real' name='[Calculation_0589363863179264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Internet Service], [Contract]: AVG([Monthly Charges])}' />
      </column>
      <column caption='More Than Avg Monthly Charges' datatype='integer' name='[Calculation_0589363886104582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Monthly Charges]) &gt; 75 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Chrun Rate%' datatype='real' name='[Calculation_0991784773959680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Churn Label] = &apos;Yes&apos; THEN 1 ELSE 0 END) / COUNT([CustomerID])' />
      </column>
      <column caption='Churn Counts' datatype='integer' name='[Calculation_0991784774135809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Churn Label]=&apos;Yes&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Revenue Lost' datatype='real' name='[Calculation_0991784777990150]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Churn Label] = &apos;Yes&apos; THEN [Monthly Charges] ELSE 0 END' />
      </column>
      <column caption='Price Variance' datatype='real' name='[Calculation_0991784782299144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Monthly Charges] - {FIXED [Internet Service], [Contract]: AVG([Monthly Charges])}' />
      </column>
      <column caption='Cus Churn Reason' datatype='string' name='[Calculation_1303774306914304]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Churn Label]=&apos;Yes&apos; THEN [Churn Reason] ELSE &quot;Not Churned&quot; END' />
      </column>
      <column caption='Cus Churn Label' datatype='string' name='[Calculation_1303774309056518]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Churn Label]=&apos;Yes&apos; THEN &quot;CHURN LABEL: Yes&quot; ELSE &quot;CHURN LABEL: No&quot; END' />
      </column>
      <column caption='Cus Internet Service' datatype='string' name='[Calculation_1303774317572103]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Internet Service]=&apos;DSL&apos; THEN &quot;INTERNET SERVICE: DSL&quot; ELSEIF [Internet Service]=&apos;Fiber optic&apos; THEN &quot;INTERNET SERVICE: Fiber Optics&quot; ELSE&#13;&#10;&quot;No Internet Service&quot; END' />
      </column>
      <column caption='Cus Payment Method' datatype='string' name='[Calculation_1303774319738889]' role='dimension' type='nominal'>
